    "@types/node": "^25.1.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.4.0",
    "lucide-svelte": "^0.563.0",
    "mdsvex": "^0.12.6",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
